x <- t[t$GC_UCN_MAI_2025 == "Phumi Roessei", ]
# (Optional) keep only the biggest non-empty polygon part, as you already did:
xp <- st_cast(x, "POLYGON", warn = FALSE)
xp <- xp[!st_is_empty(xp), ]
a <- as.numeric(st_area(st_transform(xp, 3857)))
