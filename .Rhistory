x_main <- st_sfc(st_union(st_geometry(x_main)), crs = 4326)
# 2) Read a raster you want to compare against (pick one you have)
r <- rast("/path/to/your/raster.tif")  # e.g., your MODIS/NTL/WSF/ghsl built-up
x <- t[t$GC_UCN_MAI_2025 == "Phumi Roessei", ]
# (Optional) keep only the biggest non-empty polygon part, as you already did:
xp <- st_cast(x, "POLYGON", warn = FALSE)
xp <- xp[!st_is_empty(xp), ]
a <- as.numeric(st_area(st_transform(xp, 3857)))
xp <- xp[a > 0, ]
x_main <- xp[which.max(a), ]
x_main <- st_sfc(st_union(st_geometry(x_main)), crs = 4326)
# 2) Read a raster you want to compare against (pick one you have)
r <- rast("/Users/simon/Library/CloudStorage/GoogleDrive-simon.a.montfort@gmail.com/My Drive/repo/cities-learning-dec-data/MODIS/lc_mcd12q1v061.t5_c_500m_s_20210101_20211231_go_epsg.4326_v20230818.tif")  # e.g., your MODIS/NTL/WSF/ghsl built-up
# 3) Ensure both are in the same CRS (use raster CRS as truth)
xv <- vect(x_main)
if (!same.crs(r, xv)) {
xv <- project(xv, crs(r))
}
# 4) Crop to the polygon bbox with a little padding
e <- ext(xv)
pad_x <- 0.2 * (xmax(e) - xmin(e))
pad_y <- 0.2 * (ymax(e) - ymin(e))
e2 <- ext(xmin(e)-pad_x, xmax(e)+pad_x, ymin(e)-pad_y, ymax(e)+pad_y)
r2 <- crop(r, e2)
library(sf)
