scale_fill_gradient2(
low = "white", mid = "#fff1cc", high = "#963d03",
oob = scales::squish
) +
labs(
x = "Main city type (hard assignment)",
y = "Secondary city type (soft assignment)",
title = "Overlapping cluster membership"
) +
theme_SM() +
