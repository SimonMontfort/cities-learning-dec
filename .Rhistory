p_n_studies <- clust %>%
left_join(cluster_names, by = "consensus_label_majority") %>%
group_by(cluster_name) %>%
summarise(n_studies = sum(n_studies)) %>%
ggplot(aes(x = cluster_name, y = n_studies)) +
geom_bar(stat = "identity", position = "stack", width = .5, col = "black", fill = "#a892c7", size=0.1, alpha = .5) +
coord_flip() +
scale_y_continuous(labels = label_number(suffix = "K", scale = 1e-3)) +
theme_SM() +
theme(legend.title = element_text(),
legend.position = "none",
axis.title = element_text(size = 10)) +
labs(x = "", y = "Studies", subtitle = "Total number of studies")
p_learning_potential <- ggarrange(p_cities_per_cluster_n,
p_over_under_researched_by_clust + theme(axis.text.y = element_blank()),
p_n_studies + theme(axis.text.y = element_blank()),
align = "h", labels = c("a", "b", "c"),
widths = c(1.5,1,1),
nrow = 1
)
p_learning_potential <- ggarrange(p_cities_per_cluster_n,
similarity_by_type,
# p_over_under_researched_by_clust,
p_n_studies,
align = "h", labels = c("c", "d", "e"),
# widths = c(1.5,1,1),
ncol = 1
)
p_learning <- ggarrange(p_learning_map, p_learning_potential, labels = c("", ""), ncol = 2, widths = c(1.5,1))
ggsave(p_learning, file = "plots/p_learning.pdf", height = 6, width = 10)
