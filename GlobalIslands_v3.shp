        :options-licenses="[{&quot;id&quot;:1,&quot;t_and_c&quot;:&quot;https://creativecommons.org/licenses/by/4.0/legalcode&quot;,&quot;created_at&quot;:&quot;2022-03-15T15:24:18.607Z&quot;,&quot;updated_at&quot;:&quot;2022-03-15T15:24:18.607Z&quot;,&quot;license_id&quot;:1,&quot;account_required&quot;:false,&quot;title&quot;:&quot;CC BY Attribution 4.0 International&quot;,&quot;external_access_url&quot;:null,&quot;card_contents&quot;:{&quot;subtitle_one&quot;:&quot;What is this?&quot;,&quot;subtitle_two&quot;:&quot;Are you able to contribute?&quot;,&quot;text_one&quot;:&quot;Use of this product is permitted with attribution. The UN emblem must not be included in derivatives.&quot;,&quot;text_two&quot;:&quot;To keep these products current, accurate and open, we welcome donations to support \u003ca href=&#39;https://doi.org/10.1371/journal.pone.0160640&#39;\u003eassociated costs\u003c/a\u003e.&quot;}}]"  
